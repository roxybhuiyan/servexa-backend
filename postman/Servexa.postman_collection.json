      { "name": "Create Service", "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{providerAccessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Example Service\",\n  \"description\": \"Example description\",\n  \"price\": \"1000.00\",\n  \"duration\": 60,\n  \"serviceArea\": \"Dhaka\",\n  \"status\": \"ACTIVE\"\n}"},"url":"{{baseUrl}}/api/v1/providers/me/services"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code === 201) pm.collectionVariables.set('serviceId', pm.response.json().data.id);"]}}] },
      { "name": "Update Service", "request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{providerAccessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{ \"price\": \"1200.00\", \"status\": \"ACTIVE\" }"},"url":"{{baseUrl}}/api/v1/providers/me/services/{{serviceId}}"} },
      { "name": "Delete Service", "request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{providerAccessToken}}"}],"url":"{{baseUrl}}/api/v1/providers/me/services/{{serviceId}}"} },
      { "name": "Get My Availability", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{providerAccessToken}}"}],"url":"{{baseUrl}}/api/v1/providers/me/availability?serviceId={{serviceId}}&page=1&limit=10&sortOrder=asc"} },
      { "name": "Create Availability", "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{providerAccessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{ \"serviceId\": \"{{serviceId}}\", \"startTime\": \"2030-01-01T10:00:00.000Z\", \"endTime\": \"2030-01-01T11:00:00.000Z\" }"},"url":"{{baseUrl}}/api/v1/providers/me/availability"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code === 201) pm.collectionVariables.set('slotId', pm.response.json().data.id);"]}}] },
      { "name": "Update Availability", "request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{providerAccessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{ \"startTime\": \"2030-01-01T12:00:00.000Z\", \"endTime\": \"2030-01-01T13:00:00.000Z\" }"},"url":"{{baseUrl}}/api/v1/providers/me/availability/{{slotId}}"} },
      { "name": "Delete Availability", "request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{providerAccessToken}}"}],"url":"{{baseUrl}}/api/v1/providers/me/availability/{{slotId}}"} },
