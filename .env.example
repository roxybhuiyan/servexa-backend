NODE_ENV=development
PORT=5000
# Comma-separated browser origins. In production list only deployed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Runtime/Prisma CLI URL; use a Neon pooled PostgreSQL URL locally as configured.
DATABASE_URL=
# Direct URL is used by prisma/seed.ts. Do not commit a real URL.
DIRECT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

PLATFORM_FEE_PERCENT=10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# The backend derives /payments/success and /payments/cancel from this URL.
APP_BASE_URL=http://localhost:5000
